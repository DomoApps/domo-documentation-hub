{
  // Mirror .editorconfig for contributors who don't have the EditorConfig
  // extension installed. Keep these in sync if .editorconfig changes.
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "customLocalFormatters.formatters": [
    {
      "command": "/bin/bash scripts/format-mdx.sh",
      "languages": ["mdx"]
    }
  ],
  "[mdx]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "jkillian.custom-local-formatters"
  },
  "filterText.commandList": [
    {
      "name": "Convert HTML table to pipe table",
      "description": "Replace the selected <table>...</table> with a padded Markdown pipe table.",
      "command": "python3 scripts/html-table-to-mdx.py"
    }
  ]
}
